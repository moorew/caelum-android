<?xml version="1.0" encoding="utf-8"?>
<!--
  Caelum launcher background — a deep-observatory radial gradient: a faint warm
  glow near the top fading to the night field, then near-black at the edges.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="40"
                android:gradientRadius="78">
                <item android:offset="0.0" android:color="#FF1B2A5B" />
                <item android:offset="0.52" android:color="#FF0B1020" />
                <item android:offset="1.0" android:color="#FF05070F" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
