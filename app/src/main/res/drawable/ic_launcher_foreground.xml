<!--
  Caelum launcher icon foreground — the aperture-C mark (an all-sky lens ring
  opening into a "C" with a gold focus star), scaled into the adaptive-icon
  safe zone, plus a few scattered companion stars.

  The mark paths are authored in a 100×100 space (matching ic_caelum_mark.xml)
  and placed via a group: scaled 0.66 about pivot (50,50) and nudged to centre
  on (54,54) in the 108 viewport. Max content radius ≈ 30 from centre — inside
  the 33dp Material safe-zone circle, so it survives every OEM mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="50"
        android:pivotY="50"
        android:scaleX="0.66"
        android:scaleY="0.66"
        android:translateX="4"
        android:translateY="4">

        <!-- faint dome ring -->
        <path android:strokeColor="#E8ECF4" android:strokeAlpha="0.20" android:strokeWidth="1.8"
            android:pathData="M50,5 a45,45 0 1,0 0.01,0" />
        <!-- bold C aperture (open to the right) -->
        <path android:strokeColor="#E8ECF4" android:strokeWidth="8.5" android:strokeLineCap="round"
            android:pathData="M76.05,28.14 A34,34 0 1 0 76.05,71.86" />
        <!-- gold focus star -->
        <path android:fillColor="#E9C46A"
            android:pathData="M50,35 C51.7,46 54,48.3 65,50 C54,51.7 51.7,54 50,65 C48.3,54 46,51.7 35,50 C46,48.3 48.3,46 50,35 Z" />
    </group>

    <!-- scattered companion stars (in 108-space, kept inside the safe zone) -->
    <path android:fillColor="#E8ECF4" android:fillAlpha="0.90" android:pathData="M70,34 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0z" />
    <path android:fillColor="#E8ECF4" android:fillAlpha="0.55" android:pathData="M76,52 m-1.0,0 a1.0,1.0 0 1,0 2.0,0 a1.0,1.0 0 1,0 -2.0,0z" />
    <path android:fillColor="#E9C46A" android:fillAlpha="0.85" android:pathData="M68,70 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0z" />
    <path android:fillColor="#E8ECF4" android:fillAlpha="0.50" android:pathData="M38,72 m-1.0,0 a1.0,1.0 0 1,0 2.0,0 a1.0,1.0 0 1,0 -2.0,0z" />
    <path android:fillColor="#E8ECF4" android:fillAlpha="0.45" android:pathData="M34,40 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0z" />
</vector>
