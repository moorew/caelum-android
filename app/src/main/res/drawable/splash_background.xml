<?xml version="1.0" encoding="utf-8"?>
<!--
  Branded cold-start window background: the Caelum field with the aperture-C
  mark centred. Shown until Compose draws the first frame. Works on every API
  level (no SplashScreen-API dependency required).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item
        android:drawable="@drawable/ic_caelum_mark"
        android:gravity="center"
        android:width="96dp"
        android:height="96dp" />
</layer-list>
